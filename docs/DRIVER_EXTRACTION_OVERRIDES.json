{
  "_approved": "Nihas, 2026-09-24: D1, D2, D3, D4, D5, D8, D9 and D10 approved as proposed in docs/DRIVER_EXTRACTION_DECISIONS.md (D1 with the narrow @pulse/features scope).",
  "decisions": {
    "D1_sharedFeatures": true,
    "D9_barrelRewritesForDriverCode": true,
    "D10_typeOnlyStaysMainOnly": true
  },
  "rewrites": [
    {
      "from": "lib/supabase.ts",
      "to": "lib/platform/index.ts",
      "decision": "D2",
      "why": "path-only: import configurePlatformDb from lib/platform/db/platformDb"
    }
  ],
  "patterns": [
    {
      "match": "^lib/platform/(moderator|scalability|db)/",
      "cls": "SHARED_CORE",
      "decision": "D2",
      "why": "request moderation / scalability / DB wiring = infrastructure"
    },
    {
      "match": "^lib/platform/index\\.ts$",
      "cls": "SHARED_DOMAIN",
      "decision": "D2",
      "why": "temporary compatibility shim (oms @pulse-platform untouched)"
    },
    {
      "match": "^lib/platform/(services|repositories|mappers|orchestration|events)/",
      "cls": "SHARED_DOMAIN",
      "decision": "D2",
      "why": "platform business services"
    },
    {
      "match": "^lib/platform-identity/",
      "cls": "SHARED_DOMAIN",
      "decision": "D2",
      "why": "platform identity/workspace"
    },
    {
      "match": "^contexts/(OrganizationContext|ActiveWorkspaceContext)\\.tsx$",
      "cls": "SHARED_CORE",
      "decision": "D3",
      "why": "shared context; driver app supplies its own DRIVER_ADAPTER provider; context logic unchanged"
    },
    {
      "match": "^features/driver/services/driverLocation\\.service\\.ts$",
      "cls": "SHARED_DOMAIN",
      "decision": "D4",
      "why": "used by trip detail + track & trace"
    },
    {
      "match": "^features/driver/job-card/deliveryProof\\.ts$",
      "cls": "SHARED_DOMAIN",
      "decision": "D4",
      "why": "used by tripCompliance"
    },
    {
      "match": "^features/driver/tripHistory/tripHistoryDetail\\.util\\.ts$",
      "cls": "SHARED_DOMAIN",
      "decision": "D4",
      "why": "used by TripDetailScreen"
    },
    {
      "match": "^contexts/DriverThemeContext\\.tsx$",
      "cls": "SHARED_UI",
      "decision": "D4",
      "why": "theme used by trips/operations/shared"
    },
    {
      "match": "^contexts/DriverAvatarContext\\.tsx$",
      "cls": "SHARED_CORE",
      "decision": "D4",
      "why": "next to lib/avatarUpload"
    },
    {
      "match": "^features/driver/components/RazorpayTestPreviewSheet\\.tsx$",
      "cls": "SHARED_FEATURES",
      "decision": "D4",
      "why": "used by network/OrgMyBidsList"
    },
    {
      "match": "^features/trips/utils/mapRouteViewport\\.util\\.ts$",
      "cls": "SHARED_CORE",
      "decision": "D5",
      "why": "pure viewport math, maps infrastructure"
    },
    {
      "match": "^components/driver/DriverMapAvatarMarker\\.tsx$",
      "cls": "SHARED_UI",
      "decision": "D8",
      "why": "used by shared LeafletMap family"
    },
    {
      "match": "^lib/maps/leafletNativeImplementation\\.ts$",
      "cls": "SHARED_UI",
      "decision": "D8",
      "why": "component loader, not infrastructure"
    },
    {
      "match": "^features/auth/signup/",
      "cls": "SHARED_UI",
      "fallback": "SHARED_FEATURES",
      "decision": "D1",
      "why": "signup shell/keypad UI (rendering files only; non-rendering signup files follow the normal rules); @pulse/features if runtime deps need domain",
      "jsxOnly": true
    }
  ]
}
