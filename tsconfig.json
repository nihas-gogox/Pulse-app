{
  "extends": "expo/tsconfig.base.json",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@/*": ["./*"],
      "@/ui/*": ["./components/*"],
      "@/lib/*": ["./lib/*"],
      "@/features/*": ["./features/*"],
      "@pulse/core/*": ["./packages/core/*"],
      "@pulse/domain/*": ["./packages/domain/*"],
      "@pulse/ui/*": ["./packages/ui/*"],
      "@pulse/features/*": ["./packages/features/*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", "**/*.d.ts", ".expo/types/**/*.ts", "expo-env.d.ts"],
  "exclude": [
    "node_modules",
    "**/__tests__/**",
    "supabase/functions/**",
    "oms/**",
    "analytics/**",
    "tools/**",
    "_reference/**",
    "packages/**",
    "apps/**"
  ]
}
