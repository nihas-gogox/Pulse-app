# Pulse V2 — isolated from production Pulse / pulse-unified-base.
# Copy to packages/pulse-v2/.env.v2 (do not commit). Never reuse EXPO_PUBLIC_* / VITE_* / unprefixed SUPABASE_*.

# In-memory (default for this slice):
# PULSE_V2_SUPABASE_URL=
# PULSE_V2_SUPABASE_ANON_KEY=
# PULSE_V2_SUPABASE_SERVICE_ROLE_KEY=

# Local Supabase (V2 schemas in packages/pulse-v2/supabase/migrations — not repo-root supabase/migrations):
# PULSE_V2_SUPABASE_URL=http://127.0.0.1:54321
# PULSE_V2_SUPABASE_ANON_KEY=<local anon>
# PULSE_V2_SUPABASE_SERVICE_ROLE_KEY=<local service_role — migrations/operators only; never domain adapters>

# Dedicated hosted V2: NOT PROVISIONED. Do not set a *.supabase.co URL.
# After infra approval + a real project:
#   PULSE_V2_ALLOW_HOSTED=1
#   PULSE_V2_HOSTED_PROJECT_REF=<approved-ref-not-in-the-production-denylist>
# This slice still refuses to connect or migrate hosted.

# Local durable Commerce/Execution (not hosted, not production Postgres):
# PULSE_V2_DATA_DIR=/absolute/path/to/local-v2-data
# Do not set PULSE_V2_SUPABASE_URL at the same time. Deny-all RLS is unchanged.

# PULSE_V2_ALLOW_HOSTED=0
# PULSE_V2_HOSTED_PROJECT_REF=
