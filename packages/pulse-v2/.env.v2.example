# Pulse V2 — isolated from production Pulse / pulse-unified-base.
# Copy to packages/pulse-v2/.env.v2 (do not commit). Never reuse EXPO_PUBLIC_SUPABASE_*.
#
# Day-1 slice uses an in-memory data plane. Leave PULSE_V2_SUPABASE_URL unset.
#
# Local Supabase (future V2 schema — not this repo's supabase/migrations):
#   PULSE_V2_SUPABASE_URL=http://127.0.0.1:54321
#
# Dedicated hosted V2 project: STOP. Do not provision or set a *.supabase.co URL
# until infrastructure approval. Then:
#   PULSE_V2_ALLOW_HOSTED=1
#   PULSE_V2_HOSTED_PROJECT_REF=<approved-ref-not-in-the-production-denylist>
#   PULSE_V2_SUPABASE_URL=https://<approved-ref>.supabase.co
#
# Blocked (always): production and preprod Pulse project refs. See
# src/env/productionProjectRefs.ts

# PULSE_V2_SUPABASE_URL=
# PULSE_V2_ALLOW_HOSTED=0
# PULSE_V2_HOSTED_PROJECT_REF=
